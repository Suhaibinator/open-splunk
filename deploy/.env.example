# This file contains the common settings consumed by the supplied Compose
# deployment. The complete runtime and deployment-variable reference is in
# deploy/README.md under "Server configuration".

# This selects which artifact Compose pulls; the pulled image also embeds its
# own product version. Use an exact published version, without the leading v.
OPEN_SPLUNK_DEPLOY_SERVER_IMAGE=ghcr.io/suhaibinator/open-splunk-server:0.MINOR.PATCH

# Use the existing ClickHouse Compose service name and the container-side native
# port (normally 9000), not localhost or a host-published port such as 9030.
OPEN_SPLUNK_SERVER_CLICKHOUSE_ADDRESS=per-clickhouse:9000

# These must match the existing ClickHouse account's CLICKHOUSE_USER and
# CLICKHOUSE_PASSWORD. CLICKHOUSE_DB may remain set to another database such as
# logs; Open Splunk creates and owns a separate open_splunk database.
OPEN_SPLUNK_SERVER_CLICKHOUSE_USERNAME=clickhouse
OPEN_SPLUNK_SERVER_CLICKHOUSE_PASSWORD=

# Google is the only browser sign-in method. Configure a Web application OAuth
# client whose redirect URI is <PUBLIC_BASE_URL>/auth/oauth/callback/.
OPEN_SPLUNK_SERVER_GOOGLE_CLIENT_ID=
OPEN_SPLUNK_SERVER_GOOGLE_CLIENT_SECRET=
OPEN_SPLUNK_SERVER_PUBLIC_BASE_URL=http://localhost:8080

# Independent PostgreSQL metadata storage. Credentials are URL-safe hex values
# when generated by generate-env.sh. Compose derives the server DSN internally.
OPEN_SPLUNK_POSTGRES_PASSWORD=

# Private MinIO bulk result/export storage, reachable only on the service network.
# Choose an exact approved image digest from your MinIO distribution or registry.
OPEN_SPLUNK_DEPLOY_MINIO_IMAGE=
OPEN_SPLUNK_SERVER_MINIO_ACCESS_KEY=open-splunk
OPEN_SPLUNK_SERVER_MINIO_SECRET_KEY=
OPEN_SPLUNK_SERVER_MINIO_BUCKET=open-splunk-artifacts

# Comma-separated Host header values accepted by the browser/API listener.
# Because the server listens on 0.0.0.0, this value must not be empty. Add every
# exact LAN IP, hostname, or reverse-proxy hostname browsers use, without URL
# schemes, paths, or ports.
OPEN_SPLUNK_SERVER_HTTP_LISTEN_ADDRESS=0.0.0.0:8080
OPEN_SPLUNK_SERVER_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to true only when a controlled reverse proxy terminates browser HTTPS,
# forwards to Open Splunk over HTTP, and replaces X-Forwarded-Proto.
OPEN_SPLUNK_SERVER_HTTP_TRUST_X_FORWARDED_PROTO=false
# Docker publishes container port 8080 on this host port.
OPEN_SPLUNK_DEPLOY_HTTP_PORT=8080

# Alerts remain configurable but cannot be enabled until this absolute public
# URL is set to the Search UI address that webhook receivers can reach.
OPEN_SPLUNK_SERVER_ALERT_PUBLIC_BASE_URL=
# Public HTTPS webhook destinations need no allowlist. Add comma-separated,
# exact DNS hostnames only when an administrator intentionally permits a
# receiver that resolves to a private, loopback, or link-local address.
OPEN_SPLUNK_SERVER_ALERT_PRIVATE_WEBHOOK_HOSTS=

# Enables the complete HEC route family on the server's HTTP listener.
OPEN_SPLUNK_SERVER_HEC_ENABLED=false

# Native capture bounds and retained-object budgets, in rows/raw bytes.
OPEN_SPLUNK_SERVER_SEARCH_CAPTURE_MAXIMUM_ROWS=100000
OPEN_SPLUNK_SERVER_SEARCH_CAPTURE_MAXIMUM_BYTES=268435456
OPEN_SPLUNK_SERVER_SEARCH_RETENTION_ORGANIZATION_BYTES=4294967296
OPEN_SPLUNK_SERVER_SEARCH_RETENTION_GLOBAL_BYTES=17179869184
