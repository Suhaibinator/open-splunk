# Generate deploy/.env with ./generate-env.sh. Release identity is captured
# from the committed repository snapshot and passed into the OCI build.
OPEN_SPLUNK_APPLICATION_VERSION=
OPEN_SPLUNK_SOURCE_REVISION=
OPEN_SPLUNK_IMAGE_CREATED=
OPEN_SPLUNK_SOURCE_DATE_EPOCH=
OPEN_SPLUNK_SERVER_IMAGE=

# Keep credentials empty so a copied example cannot accidentally start either
# persistence plane with known secrets.
OPEN_SPLUNK_CLICKHOUSE_BOOTSTRAP_PASSWORD=
OPEN_SPLUNK_CLICKHOUSE_MIGRATION_PASSWORD=
OPEN_SPLUNK_CLICKHOUSE_RUNTIME_PASSWORD=
OPEN_SPLUNK_CLICKHOUSE_DELETION_PASSWORD=
OPEN_SPLUNK_CLICKHOUSE_BACKUP_PASSWORD=
OPEN_SPLUNK_CLICKHOUSE_RESTORE_PASSWORD=
OPEN_SPLUNK_CLICKHOUSE_MIGRATION_PASSWORD_FILE=
OPEN_SPLUNK_CLICKHOUSE_RUNTIME_PASSWORD_FILE=
OPEN_SPLUNK_CLICKHOUSE_DELETION_PASSWORD_FILE=
OPEN_SPLUNK_CLICKHOUSE_BACKUP_PASSWORD_FILE=
OPEN_SPLUNK_CLICKHOUSE_RESTORE_PASSWORD_FILE=

# Recovery helpers use this private path inside the server-recovery volume.
# OPEN_SPLUNK_DEPLOYMENT_RECOVERY_SET_PATH=/var/lib/open-splunk/recovery/private/deployment-recovery-set

# A restored deployment keeps docker-compose.recovery-target.yaml for its full
# lifetime. Set these only to four independently verified fresh named volumes.
# OPEN_SPLUNK_RECOVERY_CLICKHOUSE_DATA_VOLUME=
# OPEN_SPLUNK_RECOVERY_CLICKHOUSE_LOGS_VOLUME=
# OPEN_SPLUNK_RECOVERY_SERVER_STATE_VOLUME=
# OPEN_SPLUNK_RECOVERY_SERVER_EXPORTS_VOLUME=

# Stale-marker reconciliation is deliberately inert until an operator repeats
# both identities obtained from the same interrupted-backup diagnostic.
# OPEN_SPLUNK_STALE_RECOVERY_SET_ID=
# OPEN_SPLUNK_CONFIRMED_STALE_RECOVERY_SET_ID=
# OPEN_SPLUNK_STALE_BACKUP_OPERATION_UUID=
# OPEN_SPLUNK_CONFIRMED_STALE_BACKUP_OPERATION_UUID=

# generate-env.sh also writes absolute paths for a private local CA and the
# ClickHouse server identity. Empty placeholders keep copied examples inert.
OPEN_SPLUNK_CLICKHOUSE_TLS_CA_FILE=
OPEN_SPLUNK_CLICKHOUSE_TLS_CERT_FILE=
OPEN_SPLUNK_CLICKHOUSE_TLS_KEY_FILE=
OPEN_SPLUNK_CLICKHOUSE_TLS_SERVER_NAME=

# The browser/API and collector listeners share a distinct generated server
# identity. The administrator token source is mounted only by the one-shot
# non-root provisioning service; the long-running server reads its private
# copy from the state volume.
OPEN_SPLUNK_SERVER_TLS_CA_FILE=
OPEN_SPLUNK_SERVER_TLS_CERT_FILE=
OPEN_SPLUNK_SERVER_TLS_KEY_FILE=
OPEN_SPLUNK_SERVER_TLS_SERVER_NAME=
OPEN_SPLUNK_ADMINISTRATOR_TOKEN_FILE=

# Host-side application ports are optional and always bind to 127.0.0.1.
# ClickHouse has no host-published port in the full-stack deployment.
# OPEN_SPLUNK_SERVER_HTTP_PORT=8080
# OPEN_SPLUNK_SERVER_GRPC_PORT=4317

# HEC shares the browser/API HTTPS listener and is disabled by default. Set
# this to true only after creating an appropriately scoped HEC-purpose token.
# OPEN_SPLUNK_HEC_ENABLED=false
