# Use an exact published Open Splunk version, without the leading v.
OPEN_SPLUNK_SERVER_IMAGE=ghcr.io/suhaibinator/open-splunk-server:0.MINOR.PATCH

# Existing ClickHouse native-protocol connection. The configured account must
# be able to create and migrate the dedicated open_splunk database and perform
# all application reads, writes, inspection queries, and deletion mutations.
OPEN_SPLUNK_CLICKHOUSE_ADDRESS=per-clickhouse:9000
OPEN_SPLUNK_CLICKHOUSE_USERNAME=clickhouse
OPEN_SPLUNK_CLICKHOUSE_PASSWORD=

# Generate once with: openssl rand -base64 48
OPEN_SPLUNK_ADMINISTRATOR_TOKEN=

# Comma-separated Host header values accepted by the browser/API listener.
# Add the server's LAN hostname or IP when it is not accessed as localhost.
OPEN_SPLUNK_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
OPEN_SPLUNK_SERVER_HTTP_PORT=8080
OPEN_SPLUNK_HEC_ENABLED=false
