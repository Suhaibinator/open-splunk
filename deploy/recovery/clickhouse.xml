<clickhouse>
  <tcp_port remove="remove"/>
  <http_port remove="remove"/>
  <tcp_port_secure>9440</tcp_port_secure>
  <openSSL>
    <server>
      <certificateFile>/run/recovery/server.crt</certificateFile>
      <privateKeyFile>/run/recovery/server.key</privateKeyFile>
      <verificationMode>none</verificationMode>
      <loadDefaultCAFile>false</loadDefaultCAFile>
      <disableProtocols>sslv2,sslv3,tlsv1,tlsv1_1</disableProtocols>
    </server>
  </openSSL>
  <access_control_improvements>
    <select_from_system_db_requires_grant>true</select_from_system_db_requires_grant>
  </access_control_improvements>
  <storage_configuration>
    <disks>
      <open_splunk_recovery>
        <type>local</type>
        <path>/var/lib/open-splunk-clickhouse-backups/</path>
      </open_splunk_recovery>
    </disks>
  </storage_configuration>
  <backups>
    <allowed_disk>open_splunk_recovery</allowed_disk>
    <allow_concurrent_backups>false</allow_concurrent_backups>
    <allow_concurrent_restores>false</allow_concurrent_restores>
    <remove_backup_files_after_failure>true</remove_backup_files_after_failure>
  </backups>
</clickhouse>
