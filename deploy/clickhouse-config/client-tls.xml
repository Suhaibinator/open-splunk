<config>
    <!-- Used only by the container healthcheck. It must authenticate the same
         secure native listener that the Open Splunk server uses. -->
    <openSSL>
        <client>
            <caConfig>/etc/clickhouse-client/open-splunk-ca.crt</caConfig>
            <loadDefaultCAFile>false</loadDefaultCAFile>
            <cacheSessions>false</cacheSessions>
            <disableProtocols>sslv2,sslv3,tlsv1,tlsv1_1</disableProtocols>
            <verificationMode>strict</verificationMode>
            <invalidCertificateHandler>
                <name>RejectCertificateHandler</name>
            </invalidCertificateHandler>
        </client>
    </openSSL>
</config>
