<clickhouse>
    <users>
        <!-- The official image's base default user is network-wide and
             passwordless when user setup is skipped. Remove it completely;
             every deployment connection must use an explicit principal. -->
        <default remove="remove"/>
        <open_splunk_bootstrap>
            <password from_env="CLICKHOUSE_PASSWORD"/>
            <networks>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </open_splunk_bootstrap>
    </users>
</clickhouse>
