# The OCI build is intentionally deny-by-default. Only inputs consumed by the
# pinned Node and Go stages cross the Docker build-context boundary.
**
!Dockerfile
!.dockerignore
!go.mod
!go.sum
!package.json
!package-lock.json
!next-env.d.ts
!next.config.ts
!tsconfig.json
!webui.go
!README.md
!AGENTS.md
!CLAUDE.md
!docs/
!docs/*.md
!configs/
!configs/examples/
!configs/examples/collector.yaml
!configs/examples/collector-container.yaml
!deploy/
!deploy/README.md
!deploy/docker-compose.yaml
!deploy/docker-compose.recovery.yaml
!deploy/docker-compose.recovery-restore.yaml
!deploy/recovery/
!deploy/recovery/users.xml.template
!app/
!app/**/
!app/**/*.css
!app/**/*.ts
!app/**/*.tsx
!cmd/
!cmd/**/
!cmd/**/*.go
!gen/
!gen/**/
!gen/**/*.go
!gen/**/*.ts
!gen/go/README.md
!gen/ts/README.md
!integration/
!integration/README.md
!internal/
!internal/**/
!internal/**/*.go
!internal/spl/completion_catalog.json
!internal/hec/testdata/compatibility/README.md
!lib/
!lib/**/
!lib/**/*.ts
!lib/**/*.tsx
!lib/help/documentation-registry.mjs
!migrations/
!migrations/embed.go
!migrations/README.md
!migrations/clickhouse/
!migrations/clickhouse/*.sql
!migrations/sqlite/
!migrations/sqlite/*.sql
!proto/
!proto/**/
!proto/**/*.proto
!public/
!public/.gitkeep
!scripts/
!scripts/build-ui.mjs
!scripts/build-ui-output.mjs
!scripts/build-help.mjs
!scripts/README.md
!oci/
!oci/rootfs/
!oci/rootfs/etc/
!oci/rootfs/etc/passwd
!oci/rootfs/etc/group

# Tests are never release build inputs, even when they use an otherwise
# allowlisted source extension.
**/*_test.go
**/*.test.ts
**/*.test.tsx
