{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Open Splunk SPL v0.3 activation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format_version",
    "phase",
    "compatibility",
    "prerequisite",
    "runtime",
    "artifacts",
    "ci",
    "release",
    "receipts",
    "decision"
  ],
  "properties": {
    "$schema": { "const": "./manifest.schema.json" },
    "format_version": { "const": "open-splunk-spl-v0.3-activation-evidence-v1" },
    "phase": {
      "enum": ["implementation-checkpoint", "qualification-candidate", "accepted"]
    },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "prerequisite": { "$ref": "#/$defs/prerequisite" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "artifacts": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "ci": { "$ref": "#/$defs/ci" },
    "release": { "$ref": "#/$defs/release" },
    "receipts": {
      "type": "array",
      "items": { "$ref": "#/$defs/receipt" }
    },
    "decision": { "$ref": "#/$defs/decision" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "object_id": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_authored_search", "target_authored_search", "knowledge_expression"],
      "properties": {
        "runtime_authored_search": { "enum": ["0.2", "0.3"] },
        "target_authored_search": { "const": "0.3" },
        "knowledge_expression": { "const": "0.1" }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v02_status",
        "evidence_path",
        "evidence_sha256",
        "evidence_revision",
        "runtime_revision"
      ],
      "properties": {
        "v02_status": { "enum": ["pending", "accepted"] },
        "evidence_path": { "type": ["string", "null"] },
        "evidence_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "evidence_revision": {
          "anyOf": [{ "$ref": "#/$defs/object_id" }, { "type": "null" }]
        },
        "runtime_revision": {
          "anyOf": [{ "$ref": "#/$defs/object_id" }, { "type": "null" }]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_binding",
        "revision",
        "tree",
        "candidate_acceptance_sha256",
        "remote_ref",
        "remote_readback_revision"
      ],
      "properties": {
        "revision_binding": {
          "enum": ["unbound", "containing-commit", "recorded-runtime-parent"]
        },
        "revision": {
          "anyOf": [{ "$ref": "#/$defs/object_id" }, { "type": "null" }]
        },
        "tree": {
          "anyOf": [{ "$ref": "#/$defs/object_id" }, { "type": "null" }]
        },
        "candidate_acceptance_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "remote_ref": { "type": ["string", "null"] },
        "remote_readback_revision": {
          "anyOf": [{ "$ref": "#/$defs/object_id" }, { "type": "null" }]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflow",
        "run_id",
        "url",
        "event",
        "head_revision",
        "status",
        "conclusion",
        "completed_at_utc",
        "jobs"
      ],
      "properties": {
        "repository": { "type": ["string", "null"] },
        "workflow": { "const": "CI" },
        "run_id": { "type": ["integer", "null"], "minimum": 1 },
        "url": { "type": ["string", "null"] },
        "event": { "type": ["string", "null"] },
        "head_revision": {
          "anyOf": [{ "$ref": "#/$defs/object_id" }, { "type": "null" }]
        },
        "status": { "enum": ["completed", null] },
        "conclusion": { "enum": ["success", null] },
        "completed_at_utc": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "status", "conclusion"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "status": { "const": "completed" },
        "conclusion": { "const": "success" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "spl_compatibility_version",
        "application_version",
        "binary_identities",
        "artifact_digests"
      ],
      "properties": {
        "source_revision": {
          "anyOf": [{ "$ref": "#/$defs/object_id" }, { "type": "null" }]
        },
        "spl_compatibility_version": { "enum": ["0.3", null] },
        "application_version": { "enum": ["0.2.0", null] },
        "binary_identities": {
          "type": "array",
          "items": { "$ref": "#/$defs/binary_identity" }
        },
        "artifact_digests": {
          "type": "array",
          "items": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "binary_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "application_version", "source_revision", "spl_compatibility_version"],
      "properties": {
        "name": { "enum": ["open-splunk-server", "open-splunk-collector", "open-splunk-loggen"] },
        "application_version": { "const": "0.2.0" },
        "source_revision": { "$ref": "#/$defs/object_id" },
        "spl_compatibility_version": { "enum": ["0.3", null] }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "bytes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": { "type": "string", "pattern": "^receipts/[A-Za-z0-9._/-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stable_publication_authorized", "reason"],
      "properties": {
        "status": { "enum": ["pending", "accepted"] },
        "stable_publication_authorized": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
