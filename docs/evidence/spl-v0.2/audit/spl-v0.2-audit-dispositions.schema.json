{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spl-v0.2-audit-dispositions.schema.json",
  "title": "Open Splunk SPL v0.2 compatibility-audit disposition ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "target_revision",
    "target_tree",
    "audit_report_sha256",
    "compatibility_version",
    "scanned_objects",
    "finding_kind",
    "finding_count",
    "finding_tuple_fields",
    "unresolved_count",
    "unresolved",
    "categories"
  ],
  "properties": {
    "$schema": {
      "const": "spl-v0.2-audit-dispositions.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "target_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "audit_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compatibility_version": {
      "const": "0.2"
    },
    "scanned_objects": {
      "type": "integer",
      "minimum": 1
    },
    "finding_kind": {
      "const": "ambiguous_unspaced_scalar_operator"
    },
    "finding_count": {
      "type": "integer",
      "minimum": 0
    },
    "finding_tuple_fields": {
      "type": "array",
      "prefixItems": [
        {
          "const": "object_id"
        },
        {
          "const": "source_location"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "unresolved_count": {
      "const": 0
    },
    "unresolved": {
      "type": "array",
      "maxItems": 0
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "disposition",
          "rationale",
          "finding_count",
          "object_count",
          "findings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "finding_count": {
            "type": "integer",
            "minimum": 1
          },
          "object_count": {
            "type": "integer",
            "minimum": 1
          },
          "findings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
