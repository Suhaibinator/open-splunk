# Go
/build/
/.cache/
coverage.out

# Next.js / Node
/node_modules/
/.next/
*.tsbuildinfo
npm-debug.log*
/test-results/

# Next.js static export is generated before the Go server build.
/out/*
!/out/.gitkeep

# Generated local state
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/data/
/exports/

# Local configuration and environment
.env
.env.*
!.env.example

# Editor / OS
# Claude Code agent worktrees. Each is a full checkout of this repo, so an
# unignored .claude/ makes `oxlint .` discover the nested copies of
# .oxlintrc.json and abort ("denyWarnings is only supported in the root config").
/.claude/
.DS_Store
.idea/
.vscode/*
!.vscode/tasks.json
*.log
