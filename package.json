{
  "name": "open-splunk",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "allowScripts": {
    "@bufbuild/buf@1.72.0": true,
    "fsevents@2.3.2": true
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/build-ui.mjs",
    "lint": "oxlint .",
    "test:contracts": "playwright test --config=playwright.contracts.config.ts",
    "test:frontend": "node scripts/test-frontend.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "lucide-react": "^1.35.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxlint": "^1.79.0",
    "ts-proto": "^2.12.1",
    "typescript": "^7.0.2"
  }
}
