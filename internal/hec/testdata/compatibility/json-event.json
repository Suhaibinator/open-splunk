          "alias": "primary",
          "purpose": "hec",
          "state": "active",
          "ack_enabled": false,
          "allowed_indexes": ["main"],
          "defaults": {"index": "main"}
        },
        "indexes": [{"name": "main", "state": "active", "ingestion_enabled": true}],
