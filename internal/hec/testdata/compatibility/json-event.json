        "durable": {"quota": "charged", "request": "staged", "ack": "absent", "outbox": "pending", "visibility": "reserved"},
        "events": [
          {"ordinal": 0, "index": "main", "time_unix_nanos": "1786363200000000000", "time_source": "received_at_fallback", "host": "hec", "source": "http:hec", "sourcetype": "httpevent", "raw": "{}", "fields": []},
          {"ordinal": 1, "index": "main", "time_unix_nanos": "1786363200000000000", "time_source": "received_at_fallback", "host": "hec", "source": "http:hec", "sourcetype": "httpevent", "raw": "[]", "fields": []}
        ],
        "spl": {"query": "index=main sourcetype=httpevent | fields _raw", "rows": [{"_raw": "{}"}, {"_raw": "[]"}]}
      }
    },
    {
      "id": "json.missing-event",
      "rule": "a missing event member is distinct from blank and identifies envelope zero",
      "request": {
        "method": "POST",
        "path": "/services/collector/event",
        "headers": [{"name": "Authorization", "value": "Splunk {{token:primary}}"}],
        "query": [],
        "body": {"kind": "utf8", "value": "{\"host\":\"api-01\"}"}
      },
      "setup": {
        "received_at": "2026-08-10T12:00:00Z",
        "token": {"alias": "primary", "purpose": "hec", "state": "active", "ack_enabled": false, "allowed_indexes": ["main"], "defaults": {"index": "main"}},
        "indexes": [{"name": "main", "state": "active", "ingestion_enabled": true}],
        "conditions": []
      },
      "expect": {
        "http": {"status": 400, "headers": {"Content-Type": "application/json; charset=utf-8", "X-Content-Type-Options": "nosniff", "Cache-Control": "no-store"}, "body_utf8": "{\"text\":\"Event field is required\",\"code\":12,\"invalid-event-number\":0}"},
        "durable": {"quota": "absent", "request": "absent", "ack": "absent", "outbox": "absent", "visibility": "absent"},
        "events": []
      }
    },
