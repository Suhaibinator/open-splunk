{
  "format_version": 1,
  "cases": [
    {
      "id": "json.string-token-and-index-defaults",
      "rule": "a string event uses token host/source, the selected index sourcetype, exact message, and receive-time fallback",
      "request": {
        "method": "POST",
        "path": "/services/collector/event",
        "headers": [
          {"name": "Authorization", "value": "Splunk {{token:primary}}"},
          {"name": "Content-Type", "value": "application/json"}
        ],
        "query": [],
        "body": {"kind": "utf8", "value": "{\"event\":\"hello\"}"}
      },
      "setup": {
        "received_at": "2026-08-10T12:00:00Z",
        "token": {
          "alias": "primary",
          "purpose": "hec",
          "state": "active",
          "ack_enabled": false,
          "allowed_indexes": ["main"],
          "defaults": {"index": "main", "host": "token-host", "source": "token-source"}
        },
        "indexes": [{"name": "main", "state": "active", "ingestion_enabled": true, "default_sourcetype": "app:json"}],
        "conditions": []
      },
      "expect": {
        "http": {
          "status": 200,
          "headers": {
            "Content-Type": "application/json; charset=utf-8",
            "X-Content-Type-Options": "nosniff",
            "Cache-Control": "no-store"
          },
          "body_utf8": "{\"text\":\"Success\",\"code\":0}"
        },
        "durable": {"quota": "charged", "request": "staged", "ack": "absent", "outbox": "pending", "visibility": "reserved"},
        "events": [
          {
            "ordinal": 0,
            "index": "main",
            "time_unix_nanos": "1786363200000000000",
            "time_source": "received_at_fallback",
            "host": "token-host",
            "source": "token-source",
            "sourcetype": "app:json",
            "raw": "hello",
            "message": "hello",
            "fields": []
          }
        ],
        "spl": {
          "query": "index=main host=token-host | fields _raw, message",
          "rows": [{"_raw": "hello", "message": "hello"}]
        }
      }
    },
    {
      "id": "json.concatenated-exact-time-typed-fields",
      "rule": "concatenated envelopes preserve object member order, exact nanosecond time, and typed flat fields",
      "request": {
        "method": "POST",
        "path": "/services/collector",
        "headers": [
          {"name": "Authorization", "value": "Splunk {{token:primary}}"},
          {"name": "Content-Type", "value": "application/x-www-form-urlencoded"}
        ],
        "query": [],
        "body": {
          "kind": "utf8",
          "value": " {\"time\":1786323296.123456789,\"host\":\"event-host\",\"event\": { \"z\" : 1, \"a\" : 2 },\"fields\":{\"status\":200,\"ratio\":1.25,\"ok\":true,\"tags\":[\"a\",null,-2]}}\n{\"event\":false} "
        }
      },
      "setup": {
        "received_at": "2026-08-10T12:00:00Z",
        "token": {
          "alias": "primary",
          "purpose": "hec",
          "state": "active",
          "ack_enabled": false,
          "allowed_indexes": ["main"],
          "defaults": {"index": "main", "host": "token-host", "source": "token-source", "sourcetype": "token:type"}
        },
        "indexes": [{"name": "main", "state": "active", "ingestion_enabled": true, "default_sourcetype": "index:type"}],
        "conditions": []
      },
      "expect": {
        "http": {
          "status": 200,
          "headers": {
            "Content-Type": "application/json; charset=utf-8",
            "X-Content-Type-Options": "nosniff",
            "Cache-Control": "no-store"
          },
          "body_utf8": "{\"text\":\"Success\",\"code\":0}"
        },
        "durable": {"quota": "charged", "request": "staged", "ack": "absent", "outbox": "pending", "visibility": "reserved"},
        "events": [
          {
            "ordinal": 0,
            "index": "main",
            "time_unix_nanos": "1786323296123456789",
            "time_source": "explicit",
            "host": "event-host",
            "source": "token-source",
            "sourcetype": "token:type",
            "raw": "{\"z\":1,\"a\":2}",
            "fields": [
              {"name": "status", "value": {"kind": "uint64", "value": "200"}},
              {"name": "ratio", "value": {"kind": "decimal", "value": "1.25"}},
              {"name": "ok", "value": {"kind": "bool", "value": true}},
              {"name": "tags", "value": {"kind": "list", "items": [
                {"kind": "string", "value": "a"},
                {"kind": "null"},
                {"kind": "sint64", "value": "-2"}
              ]}}
            ]
          },
          {
            "ordinal": 1,
            "index": "main",
            "time_unix_nanos": "1786363200000000000",
            "time_source": "received_at_fallback",
            "host": "token-host",
            "source": "token-source",
            "sourcetype": "token:type",
            "raw": "false",
            "fields": []
          }
        ],
        "spl": {
          "query": "index=main | stats count by sourcetype",
          "rows": [{"sourcetype": "token:type", "count": 2}]
        }
      }
    },
    {
      "id": "json.fixed-metadata-fallbacks",
