{
  "format_version": "hec-compatibility-fixture-v0.1",
  "cases": [
    {
      "id": "auth.disabled-token",
      "rule": "an exact disabled HEC token uses the documented disabled category without decoding the body",
      "request": {
        "method": "POST",
        "path": "/services/collector/event",
        "headers": [{"name": "Authorization", "value": "Splunk {{token:primary}}"}],
        "query": [],
        "body": {"kind": "utf8", "value": "not-json"}
      },
      "setup": {
        "received_at": "2026-08-10T12:00:00Z",
        "token": {"alias": "primary", "purpose": "hec", "state": "disabled", "ack_enabled": false, "allowed_indexes": ["main"], "defaults": {"index": "main"}},
        "indexes": [{"name": "main", "state": "active", "ingestion_enabled": true}],
        "conditions": []
      },
      "expect": {
        "http": {"status": 403, "headers": {"Content-Type": "application/json; charset=utf-8", "X-Content-Type-Options": "nosniff", "Cache-Control": "no-store"}, "body_utf8": "{\"text\":\"Token disabled\",\"code\":1}"},
        "durable": {"quota": "absent", "request": "absent", "ack": "absent", "outbox": "absent", "visibility": "absent"},
        "events": []
      }
    },
    {
