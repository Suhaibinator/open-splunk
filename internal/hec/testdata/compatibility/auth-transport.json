    {
      "id": "transport.single-gzip-member-accepted",
      "rule": "one case-insensitive gzip content encoding is decoded within the same semantic limits",
      "request": {
        "method": "POST",
        "path": "/services/collector/event",
        "headers": [
          {"name": "Authorization", "value": "Splunk {{token:primary}}"},
          {"name": "Content-Encoding", "value": "GZip"},
          {"name": "Content-Type", "value": "application/json; charset=UTF-8"}
        ],
        "query": [],
        "body": {"kind": "gzip_utf8", "value": "{\"event\":\"compressed\"}"}
      },
      "setup": {
        "received_at": "2026-08-10T12:00:00Z",
        "token": {"alias": "primary", "purpose": "hec", "state": "active", "ack_enabled": false, "allowed_indexes": ["main"], "defaults": {"index": "main"}},
        "indexes": [{"name": "main", "state": "active", "ingestion_enabled": true}],
        "conditions": []
      },
      "expect": {
        "http": {"status": 200, "headers": {"Content-Type": "application/json; charset=utf-8", "X-Content-Type-Options": "nosniff", "Cache-Control": "no-store"}, "body_utf8": "{\"text\":\"Success\",\"code\":0}"},
        "durable": {"quota": "charged", "request": "staged", "ack": "absent", "outbox": "pending", "visibility": "reserved"},
        "events": [{"ordinal": 0, "index": "main", "time_unix_nanos": "1786363200000000000", "time_source": "received_at_fallback", "host": "hec", "source": "http:hec", "sourcetype": "httpevent", "raw": "compressed", "message": "compressed", "fields": []}],
        "spl": {"query": "index=main message=compressed | fields _raw", "rows": [{"_raw": "compressed"}]}
      }
    },
    {
