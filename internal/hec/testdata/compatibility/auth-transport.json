      "setup": {"received_at": "2026-08-10T12:00:00Z", "indexes": [], "conditions": []},
      "expect": {
        "http": {"status": 415, "headers": {"Content-Type": "application/json; charset=utf-8", "X-Content-Type-Options": "nosniff", "Cache-Control": "no-store"}, "body_utf8": "{\"text\":\"Invalid data format\",\"code\":6}"},
