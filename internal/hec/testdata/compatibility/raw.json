    {
      "id": "raw.fields-query-rejected",
      "rule": "dynamic fields require a JSON envelope and are not parsed from raw query parameters",
      "request": {
        "method": "POST",
        "path": "/services/collector/raw",
        "headers": [{"name": "Authorization", "value": "Splunk {{token:primary}}"}],
        "query": [
          {"name": "channel", "value": "FE0ECFAD-13D5-401B-847D-77833BD77131"},
