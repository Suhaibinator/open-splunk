  "rules": [
    {
      "id": "SPL-V03-PROFILE-001",
      "summary": "Authored searches use cumulative v0.3 while Tier-1 calculated fields remain v0.1.",
      "cases": [
        {"name": "authored all-ten suffix", "source": "index=main | regex message=\"ok\" | reverse | accum n AS running | strcat host \"/\" source route | addinfo | fillnull value=\"0\" optional | addtotals fieldname=total n running | delta running AS step p=2 | makemv delim=\",\" tags | mvexpand tags limit=2", "evidence":"authored-all-ten-executable-source", "fixture":"evidence.authored-all-ten", "expect": {"parse": "accept", "compatibility": "0.3"}},
        {"name": "independent all-ten semantics", "source":"index=main | regex message!=\"reject\" | reverse | accum n AS running | strcat host \"/\" route endpoint | addinfo | fillnull value=\"unknown\" optional | addtotals fieldname=total n running | delta running AS step p=1 | makemv delim=\",\" tags | mvexpand tags limit=2", "evidence": "independent-reference-model-all-ten-commands", "fixture": "reference.all-ten", "expect": {"surfaces": "complete"}},
        {"name": "knowledge profile unchanged", "evidence": "retained-v0.1-knowledge-plus-authored-v0.3-suffix", "fixture":"evidence.knowledge-profile", "expect": {"compatibility": {"authored": "0.3", "knowledge": "0.1"}}}
      ]
    },
    {
      "id": "SPL-V03-ACTIVATION-001",
      "summary": "The public identity changes only for the complete accepted ten-command vertical.",
      "cases": [
        {"name": "atomic runtime identity", "evidence": "bootstrap-job-history-export-browser", "fixture":"evidence.atomic-runtime-identity", "expect": {"compatibility": "0.3", "surfaces": "complete"}}
      ]
    },
    {
      "id": "SPL-V03-FIELDS-001",
      "summary": "Command fields are exact, unquoted, source-located, and outside the private namespace.",
      "cases": [
        {"name": "exact field accepted", "source": "index=main | fillnull host", "expect": {"parse": "accept"}},
        {"name": "quoted command field rejected", "source": "index=main | fillnull 'host name'", "expect": {"diagnostic": "SPL_EXPECTED_FIELD"}},
        {"name": "private field rejected", "source": "index=main | delta __os_pipeline_ordinal", "expect": {"diagnostic": "SPL_RESERVED_FIELD"}}
      ]
    },
    {
      "id": "SPL-V03-REGEX-001",
      "summary": "Regex filtering shares the bounded RE2 match profile and negative missing/null behavior.",
      "cases": [
        {"name": "raw positive", "source": "index=main | regex \"(?i)timeout\"", "fixture": "reference.regex-positive", "expect": {"parse": "accept", "relation": "filter"}},
        {"name": "field negative", "source": "index=main | regex message!=\"reject\"", "fixture": "reference.regex-negative", "expect": {"parse": "accept", "value": "missing-and-null-kept"}},
        {"name": "dynamic pattern rejected", "source": "index=main | regex message=pattern", "expect": {"diagnostic": "SPL_EXPECTED_REGEX_PATTERN"}}
      ]
    },
    {
      "id": "SPL-V03-REVERSE-001",
      "summary": "Reverse inverts the complete deterministic established order without changing rows or fields.",
      "cases": [
        {"name": "repeated stable reversal", "source": "index=main | sort 0 +event_id | reverse | reverse", "fixture": "reference.reverse", "expect": {"parse": "accept", "order": "original-established-order"}},
        {"name": "arguments rejected", "source": "index=main | reverse 2", "expect": {"diagnostic": "SPL_UNSUPPORTED_REVERSE_SYNTAX"}}
      ]
    },
    {
      "id": "SPL-V03-ACCUM-001",
      "summary": "Accum is the shared current-row-inclusive global streamstats numeric sum.",
      "cases": [
        {"name": "default replacement", "source": "index=main | sort 0 +event_id | accum bytes", "fixture": "reference.accum-default", "expect": {"parse": "accept", "type": "nullable-float64"}},
        {"name": "explicit output", "source": "index=main | accum bytes AS running_bytes", "fixture": "reference.accum-output", "expect": {"parse": "accept", "order": "pipeline"}}
      ]
    },
    {
      "id": "SPL-V03-STRCAT-001",
      "summary": "Strcat shares bounded period concatenation with an explicit all-required write policy.",
      "cases": [
        {"name": "default missing as empty", "source": "index=main | strcat host \"/\" missing endpoint", "fixture": "reference.strcat-default", "expect": {"parse": "accept", "value": "missing-source-empty"}},
        {"name": "all required", "source": "index=main | strcat allrequired=true service \"/\" route route_key", "fixture": "reference.strcat-required", "expect": {"parse": "accept", "value": "preserve-destination-when-source-null"}},
        {"name": "minimum arity", "source": "index=main | strcat host endpoint", "expect": {"diagnostic": "SPL_UNSUPPORTED_STRCAT_SYNTAX"}}
      ]
    },
    {
      "id": "SPL-V03-ADDINFO-001",
      "summary": "Addinfo overwrites four fields from the immutable admitted search snapshot.",
      "cases": [
        {"name": "immutable metadata", "source": "index=main | addinfo | table info_min_time info_max_time info_search_time info_sid", "fixture": "reference.addinfo", "expect": {"parse": "accept", "surfaces": "admitted-snapshot"}},
        {"name": "arguments rejected", "source": "index=main | addinfo now", "expect": {"diagnostic": "SPL_UNSUPPORTED_ADDINFO_SYNTAX"}}
      ]
    },
    {
      "id": "SPL-V03-FILLNULL-001",
      "summary": "Fillnull writes one quoted String only to explicit missing or null fields.",
      "cases": [
        {"name": "default zero String", "source": "index=main | fillnull host route", "fixture": "reference.fillnull-default", "expect": {"parse": "accept", "value": "0"}},
        {"name": "explicit Unicode String", "source": "index=main | fillnull value=\"未知\" host route", "fixture": "reference.fillnull-unicode", "expect": {"parse": "accept", "type": "string"}},
        {"name":"private physical producers materialize the authored field","source":"index=main | stats count BY level | fillnull value=\"fallback\" level | table level count","evidence":"fillnull-private-physical-publication","fixture":"evidence.fillnull-private-physical","expect":{"parse":"accept","surfaces":"dynamic-composition"}},
        {"name":"invalid-path stats literal survives ancestor publication","source":"index=main | stats count AS \"parent..child\" | fillnull value=\"fallback\" parent","evidence":"fillnull-invalid-path-stats-literal-namespace-overlap","fixture":"evidence.fillnull-invalid-path-stats-literal","expect":{"parse":"accept","surfaces":"dynamic-composition"}},
        {"name": "implicit schema form rejected", "source": "index=main | fillnull value=\"0\"", "expect": {"diagnostic": "SPL_EXPECTED_FIELD"}}
      ]
    },
    {
      "id": "SPL-V03-ADDTOTALS-001",
      "summary": "Addtotals computes one explicit nullable Float64 row total and treats ineligible inputs as zero.",
      "cases": [
        {"name": "bounded row total", "source": "index=main | addtotals row=true col=false fieldname=total bytes_in bytes_out", "fixture": "reference.addtotals", "expect": {"parse": "accept", "type": "nullable-float64"}},
        {"name": "all ineligible zero", "source": "index=main | table event_id | addtotals fieldname=total missing other", "fixture": "reference.addtotals-ineligible", "expect": {"value": {"double": 0}}},
        {"name": "column totals deferred", "source": "index=main | addtotals col=true bytes", "expect": {"diagnostic": "SPL_UNSUPPORTED_ADDTOTALS_SYNTAX"}}
      ]
    },
    {
      "id": "SPL-V03-DELTA-001",
      "summary": "Delta performs bounded v0.2 subtraction against an established prior row.",
      "cases": [
        {"name": "default lag and output", "source": "index=main | sort 0 +event_id | delta bytes", "fixture": "reference.delta-default", "expect": {"parse": "accept", "type": "nullable-float64"}},
        {"name": "lag before alias", "source": "index=main | delta bytes p=3 AS change", "fixture": "reference.delta-output", "expect": {"parse": "accept", "order": "pipeline"}},
        {"name": "zero lag rejected", "source": "index=main | delta bytes p=0", "expect": {"diagnostic": "SPL_UNSUPPORTED_DELTA_SYNTAX"}}
      ]
    },
    {
      "id": "SPL-V03-MAKEMV-001",
      "summary": "Makemv constructs a bounded optional typed String List with literal delimiter semantics.",
      "cases": [
        {"name": "Unicode delimiter and empty members", "source": "index=main | makemv delim=\"💥界\" allowempty=true tags", "fixture": "reference.makemv-unicode", "expect": {"parse": "accept", "type": "nullable-list-string"}},
        {"name": "missing remains null", "source": "index=main | makemv delim=\",\" missing", "fixture": "reference.makemv-null", "expect": {"value": {"null": true}}},
        {"name":"non-String multivalue Bytes and container inputs rejected","source":"index=main | makemv delim=\",\" value","evidence":"makemv-rejected-domain-matrix","fixture":"evidence.makemv-rejected-domains","expect":{"atomic":true,"diagnostic_phase":"executor"}},
        {"name": "empty delimiter rejected", "source": "index=main | makemv delim=\"\" tags", "expect": {"diagnostic": "SPL_UNSUPPORTED_MAKEMV_SYNTAX"}}
      ]
    },
    {
      "id": "SPL-V03-MVEXPAND-001",
      "summary": "Mvexpand emits bounded copied rows in member order with cumulative trusted charging.",
      "cases": [
        {"name": "bounded expansion", "source": "index=main | makemv delim=\",\" tags | mvexpand tags limit=100", "fixture": "reference.mvexpand", "expect": {"parse": "accept", "order": "member-order"}},
        {"name": "empty list emits no rows", "source": "index=main | makemv delim=\",\" tags | mvexpand tags", "fixture": "reference.mvexpand-empty", "expect": {"value": "present-empty-emits-zero"}},
        {"name":"String Number Bool and time scalars preserve one row","source":"index=main | mvexpand value","fixture":"reference.mvexpand-scalars","expect":{"order":"member-order","type":"scalar-preserved"}},
        {"name":"missing whole null and explicit null member forms","source":"index=main | mvexpand values","fixture":"reference.mvexpand-null-forms","expect":{"value":"missing-whole-null-and-null-member"}},
        {"name":"fillnull Dynamic publication composes through projection into mvexpand","source":"index=main | fillnull value=\"fallback\" optional_mv | fields event_id optional_mv | mvexpand optional_mv | table event_id optional_mv","evidence":"fillnull-dynamic-publication-before-mvexpand","fixture":"evidence.fillnull-mvexpand-dynamic","expect":{"parse":"accept","order":"member-order","surfaces":"dynamic-composition"}},
        {"name": "limit overflow", "source": "index=main | mvexpand tags limit=1001", "expect": {"diagnostic": "SPL_QUERY_TOO_COMPLEX"}}
      ]
    },
    {
      "id": "SPL-V03-MULTIVALUE-TYPE-001",
      "summary": "A sealed presence sidecar distinguishes null from present empty typed String Lists.",
      "cases": [
        {"name": "null versus empty", "evidence": "queryexec-optional-multivalue-two-row-transport", "fixture": "evidence.optional-multivalue", "expect": {"type": "nullable-list-string", "value": [null, []]}},
        {"name": "invalid presence fails", "evidence": "optional-multivalue-presence-bit-2", "fixture": "evidence.invalid-presence", "expect": {"atomic": true, "diagnostic_phase": "executor"}}
      ]
    },
    {
      "id": "SPL-V03-ORDER-001",
      "summary": "Order-sensitive commands consume durable private relation and tie lineage that never becomes public.",
      "cases": [
        {"name": "composed order", "source": "index=main | sort 0 +event_id | reverse | accum n AS running | delta running AS change | makemv delim=\",\" tags | mvexpand tags | reverse", "fixture": "reference.composed-order", "expect": {"order": "durable-private-lineage", "surfaces": "private-columns-redacted"}}
      ]
    },
    {
      "id": "SPL-V03-LIMITS-001",
      "summary": "Source and data-dependent command costs are charged at every trusted boundary.",
      "cases": [
        {"name": "field list overflow", "evidence": "fillnull-and-addtotals-65th-field", "expect": {"diagnostic": "SPL_QUERY_TOO_COMPLEX", "diagnostic_phase": "parser"}},
        {"name": "query-wide expansion", "evidence": "two-10000-row-mvexpand-stages", "fixture": "evidence.query-wide-expansion", "expect": {"resource": "15000-cumulative-rows", "atomic": true, "diagnostic_phase":"executor"}},
        {"name": "retained bytes before head", "source": "index=main | mvexpand tags | head 1", "evidence":"retained-bytes-before-downstream-head", "fixture": "evidence.retained-before-head", "expect": {"resource": "pre-downstream-stage-charge", "atomic": true, "diagnostic_phase":"executor"}}
      ]
    },
    {
      "id": "SPL-V03-ATOMIC-001",
      "summary": "Hard resource and malformed-value failures publish no observable result prefix.",
      "cases": [
        {"name": "valid prefix then marker", "evidence": "atomic-query-valid-first-row-invalid-later-row", "fixture": "evidence.valid-prefix-marker", "expect": {"atomic": true, "diagnostic_phase":"executor", "value": {"row_count": 0, "result_bytes": 0}}},
        {"name": "sink ceiling", "evidence": "atomic-manager-max-rows-below-produced-rows", "fixture": "evidence.sink-ceiling", "expect": {"atomic": true, "diagnostic_phase": "publication-preflight"}}
      ]
    },
    {
      "id": "SPL-V03-SURFACES-001",
      "summary": "Every product surface uses the same immutable v0.3 definition, shape, and version authority.",
      "cases": [
        {"name": "saved search uses persisted source", "evidence": "server-saved-object-all-ten-launch", "fixture":"evidence.saved-search", "expect": {"surfaces": "saved-search"}},
        {"name": "history rerun", "evidence": "server-history-all-ten-rerun", "fixture":"evidence.history-rerun", "expect": {"surfaces": "history"}},
        {"name": "public paging", "source": "index=main | regex message!=\"reject\" | sort 0 +event_id | reverse | accum n AS running | strcat host \"/\" source endpoint | addinfo | fillnull value=\"unknown\" optional | addtotals fieldname=total n running | delta running AS step p=1 | makemv delim=\",\" tags | mvexpand tags | reverse | table event_id tags running endpoint optional total step info_sid", "evidence": "pinned-all-ten-public-paging", "fixture":"evidence.public-paging", "expect": {"surfaces": "two-page-public-result", "parse": "accept"}}
      ]
    },
    {
      "id": "SPL-V03-DIAGNOSTICS-001",
      "summary": "Diagnostics and runtime marker classification are stable, source-located, and secret-free.",
      "cases": [
        {"name": "oversized delimiter range", "evidence": "1025-byte-makemv-delimiter", "expect": {"diagnostic": "SPL_QUERY_TOO_COMPLEX", "range": "delimiter-token"}},
        {"name": "unsupported multivalue redacted", "evidence": "clickhouse-code-395-unsupported-mvexpand-marker", "fixture": "evidence.unsupported-multivalue", "expect": {"diagnostic": "unsupported-value", "diagnostic_phase":"executor", "atomic":true, "surfaces": "no-sql-or-values"}}
      ]
    }
  ]
}
