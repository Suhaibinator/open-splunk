{
  "format_version": 1,
  "cases": [
    {
      "id": "identity.binary-case-sensitive",
      "stage": "publication",
      "rule": "Status and status are distinct object and field names",
      "expect": "accepted",
      "authority": {
        "owner": "knowledge",
        "vector": "identity-normalization"
      }
    },
    {
      "id": "precedence.private-app-global",
      "stage": "resolution",
      "rule": "an owner-private object shadows equal app and global identities",
      "expect": "private",
      "authority": {
        "owner": "knowledge-catalog",
        "vector": "resolver-precedence"
      }
    },
    {
      "id": "visibility.private-nondisclosure",
      "stage": "resolution",
      "rule": "another owner's private object is neither executable nor disclosed",
      "expect": "omitted",
      "authority": {
        "owner": "knowledge-catalog",
        "vector": "authorization-nondisclosure"
      }
    },
    {
      "id": "selector.cross-index-per-row",
      "stage": "extraction",
      "rule": "an index selector applies per event and never expands authorized indexes",
      "expect": "matching-authorized-rows-only",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "selector.missing-metadata",
      "stage": "extraction",
      "rule": "a nonempty selector dimension does not match missing or null metadata",
      "expect": "unchanged",
      "authority": {
        "owner": "knowledge",
        "vector": "selector-match"
      }
    },
    {
      "id": "extraction.before-base-filter",
      "stage": "base-filter",
      "rule": "the authored base predicate can reference an extracted field",
      "expect": "matched",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "extraction.no-match-preserves-destination",
      "stage": "extraction",
      "rule": "no regex or JSON match never erases an existing destination",
      "expect": "preserved",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "alias.preserves-source",
      "stage": "alias",
      "rule": "copying source to destination leaves source unchanged",
      "expect": "source-and-destination",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "alias.null-is-present",
      "stage": "alias",
      "rule": "a present null destination blocks a non-overwrite alias",
      "expect": "null-preserved",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "alias.missing-source-does-not-erase",
      "stage": "alias",
      "rule": "a missing alias source leaves an existing destination unchanged",
      "expect": "preserved",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "calculated.parallel-no-chain",
      "stage": "publication",
      "rule": "a calculated field cannot depend on another calculated field in its stage",
      "expect": "rejected-same-stage-dependency",
      "authority": {
        "owner": "knowledge-program",
        "vector": "parallel-stage"
      }
    },
    {
      "id": "calculated.missing-does-not-erase",
      "stage": "calculated",
      "rule": "a missing expression result leaves an existing destination unchanged",
      "expect": "preserved",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "dependency.later-stage",
      "stage": "publication",
      "rule": "an earlier stage cannot depend on a later stage",
      "expect": "rejected-stage-inversion",
      "authority": {
        "owner": "knowledge-snapshot",
        "vector": "structural-dependencies"
      }
    },
    {
      "id": "collision.possibly-overlapping-writers",
      "stage": "publication",
      "rule": "same-stage writers with selectors not provably disjoint are rejected",
      "expect": "rejected-destination-collision",
      "authority": {
        "owner": "knowledge-program",
        "vector": "parallel-stage"
      }
    },
    {
      "id": "snapshot.database-order-independent",
      "stage": "admission",
      "rule": "row permutation does not change canonical inventory order or digest",
      "expect": "equal-digest",
      "authority": {
        "owner": "knowledge-snapshot",
        "vector": "canonical-authority"
      }
    },
    {
      "id": "snapshot.catalog-mutation-isolated",
      "stage": "execution",
      "rule": "catalog mutation cannot alter an admitted job or retained export",
      "expect": "original-version",
      "authority": {
        "owner": "queryexec",
        "vector": "lifecycle-rotation"
      }
    },
    {
      "id": "lifecycle.rerun-resolves-current",
      "stage": "admission",
      "rule": "saved-search execution and history Run Again resolve current knowledge",
      "expect": "current-version-new-digest",
      "authority": {
        "owner": "server",
        "vector": "saved-search-rerun-current"
      }
    },
    {
      "id": "forward-compat.unknown-active-body",
      "stage": "resolution",
      "rule": "an unknown active definition body fails closed without repair",
      "expect": "corruption-error",
      "authority": {
        "owner": "knowledge-catalog",
        "vector": "forward-compatibility"
      }
    },
    {
      "id": "authorization.global-never-widens-indexes",
      "stage": "admission",
      "rule": "a global object's index selector cannot add a forbidden index",
      "expect": "authorized-indexes-only",
      "authority": {
        "owner": "knowledge-catalog",
        "vector": "resolver-authorized-indexes"
      }
    },
    {
      "id": "resource.aggregate-budget",
      "stage": "admission",
      "rule": "individually valid objects whose combined work exceeds a limit fail atomically",
      "expect": "rejected-query-too-complex",
      "authority": {
        "owner": "knowledge-snapshot",
        "vector": "aggregate-budget"
      }
    },
    {
      "id": "identity.ascii-stable-trim",
      "stage": "publication",
      "rule": "only the pinned ASCII whitespace set is trimmed and remaining C0 or C1 controls are rejected",
      "expect": "stable-normalized-bytes",
      "authority": {
        "owner": "knowledge",
        "vector": "identity-normalization"
      }
    },
    {
      "id": "identity.reserved-destination",
      "stage": "publication",
      "rule": "canonical, storage, fields-container, and case-folded __os_ destinations are rejected",
      "expect": "rejected-reserved-field",
      "authority": {
        "owner": "knowledge-definition",
        "vector": "reserved-destination"
      }
    },
    {
      "id": "precedence.app-global",
      "stage": "resolution",
      "rule": "an app-shared object shadows an equal global identity when no private object exists",
      "expect": "app",
      "authority": {
        "owner": "knowledge-catalog",
        "vector": "resolver-precedence"
      }
    },
    {
      "id": "visibility.corrupt-hidden",
      "stage": "resolution",
      "rule": "a corrupt private row outside the principal visibility query cannot fail or influence admission",
      "expect": "omitted-without-disclosure",
      "authority": {
        "owner": "knowledge-catalog",
        "vector": "authorization-nondisclosure"
      }
    },
    {
      "id": "selector.anchored",
      "stage": "extraction",
      "rule": "a selector glob matches the complete canonical value and never an unanchored substring",
      "expect": "complete-match-only",
      "authority": {
        "owner": "knowledge",
        "vector": "selector-match"
      }
    },
    {
      "id": "selector.case-sensitive",
      "stage": "extraction",
      "rule": "selector matching performs no case or locale folding",
      "expect": "binary-case-sensitive",
      "authority": {
        "owner": "knowledge",
        "vector": "selector-match"
      }
    },
    {
      "id": "selector.escape",
      "stage": "publication",
      "rule": "backslash quotes only star question-mark or backslash and a trailing backslash is invalid",
      "expect": "pinned-glob-grammar",
      "authority": {
        "owner": "knowledge",
        "vector": "selector-grammar"
      }
    },
    {
      "id": "selector.disjoint",
      "stage": "publication",
      "rule": "same-destination writers are accepted only when selector disjointness is proved conservatively",
      "expect": "accepted-proven-disjoint",
      "authority": {
        "owner": "knowledge-program",
        "vector": "parallel-stage"
      }
    },
    {
      "id": "selector.runtime-budget",
      "stage": "execution",
      "rule": "each metadata value is matched once per dimension and oversize aggregate work fails without truncation",
      "expect": "resource-limit",
      "authority": {
        "owner": "knowledge",
        "vector": "selector-runtime-budget"
      }
    },
    {
      "id": "extraction.optional-empty",
      "stage": "extraction",
      "rule": "a successful regex publishes an empty String for empty or nonparticipating named captures",
      "expect": "present-empty-string",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "extraction.bytes-no-match",
      "stage": "extraction",
      "rule": "regex extraction treats every Bytes input as no extraction even when bytes are valid UTF-8",
      "expect": "unchanged",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "extraction.json-null",
      "stage": "extraction",
      "rule": "an explicit JSON null selected by spath is a produced present-null value",
      "expect": "present-null",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "extraction.json-bytes-no-match",
      "stage": "extraction",
      "rule": "JSON extraction treats every Bytes input as no extraction",
      "expect": "unchanged",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "extraction.json-container-no-output",
      "stage": "extraction",
      "rule": "a selected JSON array or object is no output for the scalar destination contract",
      "expect": "unchanged",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "extraction.overwrite-true",
      "stage": "extraction",
      "rule": "a produced extraction replaces a present destination only when overwrite is true",
      "expect": "replaced",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "alias.overwrite-true",
      "stage": "alias",
      "rule": "a present alias source replaces a present destination only when overwrite is true",
      "expect": "replaced-source-copied",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "alias.null-source",
      "stage": "alias",
      "rule": "a present-null alias source produces present null while the source remains present",
      "expect": "source-and-destination-null",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "calculated.present-null",
      "stage": "calculated",
      "rule": "a present-null expression result writes null subject to overwrite policy",
      "expect": "present-null",
      "authority": {
        "owner": "queryexec",
        "vector": "runtime-edges"
      }
    },
    {
      "id": "dependency.private-scope",
      "stage": "publication",
      "rule": "a private source may depend on same-owner same-app private app-shared or global targets",
      "expect": "accepted",
      "authority": {
        "owner": "knowledge-program",
        "vector": "dependency-sharing"
      }
    },
    {
      "id": "dependency.app-private-rejected",
      "stage": "publication",
      "rule": "an app-shared source cannot depend on a private target",
      "expect": "rejected-forbidden-or-missing-target",
      "authority": {
        "owner": "knowledge-program",
        "vector": "dependency-sharing"
      }
    },
    {
      "id": "dependency.global-app-rejected",
      "stage": "publication",
      "rule": "a global source cannot depend on an app-scoped or private target",
      "expect": "rejected-forbidden-or-missing-target",
      "authority": {
        "owner": "knowledge-program",
        "vector": "dependency-sharing"
      }
    },
    {
      "id": "snapshot.catalog-mutation-during-admission",
      "stage": "admission",
      "rule": "a concurrent mutation yields a complete old or complete new SQLite snapshot and never mixed versions",
      "expect": "coherent-old-or-new",
      "authority": {
        "owner": "knowledge-catalog",
        "vector": "coherent-snapshot"
      }
    },
    {
      "id": "snapshot.response-reauthorization",
      "stage": "inspection",
      "rule": "the stored inspection is immutable while each response redacts identity after access is revoked",
      "expect": "redacted-ordinal-only",
      "authority": {
        "owner": "server",
        "vector": "inspection-reauthorization"
      }
    },
    {
      "id": "lifecycle.disable-delete-reenable",
      "stage": "publication",
      "rule": "state transitions create immutable versions and activation rechecks identity dependency and budget conflicts",
      "expect": "versioned-and-revalidated",
      "authority": {
        "owner": "knowledge-catalog-blackbox",
        "vector": "lifecycle-state-machine"
      }
    },
    {
      "id": "forward-compat.hidden-corrupt",
      "stage": "resolution",
      "rule": "unknown or corrupt hidden bodies are not decoded on an unauthorized search path",
      "expect": "omitted-without-disclosure",
      "authority": {
        "owner": "knowledge-catalog",
        "vector": "authorization-nondisclosure"
      }
    },
    {
      "id": "authorization.admin-crud",
      "stage": "api",
      "rule": "every knowledge management route requires a tenant-bound browser administrator",
      "expect": "not-found-or-forbidden-without-disclosure",
      "authority": {
        "owner": "server",
        "vector": "admin-route-boundary"
      }
    },
    {
      "id": "authorization.preview-retained-scope",
      "stage": "preview",
      "rule": "draft preview inherits a retained authorized search scope and cannot supply indexes time or visibility",
      "expect": "retained-boundaries",
      "authority": {
        "owner": "knowledge-preview",
        "vector": "retained-scope"
      }
    },
    {
      "id": "resource.catalog-capacity",
      "stage": "publication",
      "rule": "tenant app owner type version byte and idempotency ceilings reject before mutation",
      "expect": "rejected-capacity",
      "authority": {
        "owner": "knowledge-catalog-blackbox",
        "vector": "publication-capacity"
      }
    },
    {
      "id": "resource.resolver-cache",
      "stage": "admission",
      "rule": "resolver deadline permits decoded bytes concurrency and cache memory are bounded",
      "expect": "bounded-or-unavailable",
      "authority": {
        "owner": "knowledge-catalog",
        "vector": "resolver-bounds"
      }
    },
    {
      "id": "audit.redaction",
      "stage": "audit",
      "rule": "knowledge audit never stores bodies expressions event values SQL snapshots or free-form errors",
      "expect": "fixed-bounded-metadata",
      "authority": {
        "owner": "knowledge-attempt-audit",
        "vector": "scalar-redaction"
      }
    },
    {
      "id": "audit.rejected-privileged",
      "stage": "audit",
      "rule": "an authenticated rejected privileged attempt records a fixed reason or fails the route closed",
      "expect": "recorded-before-response",
      "authority": {
        "owner": "server",
        "vector": "privileged-attempt-ordering"
      }
    },
    {
      "id": "idempotency.lost-response",
      "stage": "mutation",
      "rule": "an exact client-request retry after a committed lost response returns the original outcome",
      "expect": "same-object-version-and-revision",
      "authority": {
        "owner": "knowledge-catalog",
        "vector": "lost-response-replay"
      }
    },
    {
      "id": "recovery.quarantine-corrupt-active-at-cap",
      "stage": "recovery",
      "rule": "reserved version idempotency and recovery-audit capacity can quarantine a corrupt active object when ordinary capacities are full",
      "expect": "atomically-quarantined-and-audited",
      "authority": {
        "owner": "control",
        "vector": "recovery-capacity"
      }
    },
    {
      "id": "recovery.quarantine-dependent-cascade",
      "stage": "recovery",
      "rule": "a row-and-edge-bound integrity token atomically terminally quarantines the corrupt root and every active direct or transitive dependent without decoding suspect bodies",
      "expect": "bounded-terminal-cascade-restores-admission",
      "authority": {
        "owner": "control",
        "vector": "recovery-cascade"
      }
    },
    {
      "id": "recovery.two-generation-audit-reserve",
      "stage": "recovery",
      "rule": "the recovery journal reserves one terminal transition for every lifetime physical identity including replacements after a full quarantined generation",
      "expect": "second-generation-quarantine-succeeds",
      "authority": {
        "owner": "control",
        "vector": "recovery-generations"
      }
    }
  ]
}
